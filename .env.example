# FarmSightAI Backend Configuration
# ---------------------------------
# PROVIDER_MODE=fixture : Uses mock/fixture data for tests and deterministic demos
# PROVIDER_MODE=real    : Uses live data from Open-Meteo and Google Earth Engine
PROVIDER_MODE=real

# Google Earth Engine Project ID (Required if PROVIDER_MODE=real)
EE_PROJECT=your-google-cloud-project-id

# Application Environment (development, testing, production)
APP_ENV=development

# API Settings
API_PORT=8000
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
